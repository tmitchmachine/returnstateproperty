# Copy to `.env.local` and fill in values. Never commit real keys.

# RentCast — live sale listings (MLS aggregator) + optional ZIP rent stats.
# Free tier: https://www.rentcast.io/api (~50 requests/month)
RENTCAST_API_KEY=

# Set to 1 to enrich rent $/sqft from RentCast /markets (uses extra API quota).
# RENTCAST_ENRICH_RENT=1
